{
  "id": "distinct-citekeys",
  "storeName": "Unique citekeys",
  "description": "Counts the number of unique @citekeys in a note.",
  "author": "pan4ratte",
  "updated": "2026-06-20",
  "type": "metric",
  "toggleLabel": "Distinct citekeys",
  "hint": "Counts unique @citekeys (repeats counted once; emails ignored)",
  "statusBarLabel": "Distinct citekeys",
  "defaultEnabled": false,
  "i18n": {
    "ru": {
      "storeName": "Уникальные ключи цитирования",
      "description": "Считает количество уникальных @ключей цитирования в замекте.",
      "toggleLabel": "Уникальные цитирования",
      "hint": "Считает уникальные @ключи (повторы — один раз; эл. почта игнорируется)",
      "statusBarLabel": "Уникальных цитирований"
    }
  },
  "count": {
    "mode": "captureUnique",
    "source": "raw",
    "strip": [
      {
        "pattern": "```[\\s\\S]*?```",
        "flags": "g"
      },
      {
        "pattern": "`[^`]*`",
        "flags": "g"
      },
      {
        "pattern": "\\[\\[[^\\]]*\\]\\]",
        "flags": "g"
      },
      {
        "pattern": "\\[[^\\]]*\\]\\([^)]*\\)",
        "flags": "g"
      }
    ],
    "pattern": "(?<![\\p{L}\\p{N}])@([\\p{L}][\\p{L}\\p{N}_:-]*)",
    "flags": "gu"
  }
}
