{
  "id": "distinct-citekeys",
  "storeName": "References",
  "description": "Counts the number of unique @citekeys in a note.",
  "author": "pan4ratte",
  "updated": "2026-07-06",
  "type": "metric",
  "toggleLabel": "References",
  "hint": "Counts unique @citekeys",
  "statusBarLabel": "References",
  "defaultEnabled": false,
  "i18n": {
    "ru": {
      "storeName": "Иточники",
      "description": "Считает количество уникальных @ключей цитирования в заметке.",
      "toggleLabel": "Источники",
      "hint": "Считает уникальные @ключи цитирования",
      "statusBarLabel": "Источников"
    }
  },
  "count": {
    "mode": "captureUnique",
    "source": "raw",
    "strip": [
      {
        "pattern": "```[\\s\\S]*?```",
        "flags": "g"
      },
      {
        "pattern": "`[^`]*`",
        "flags": "g"
      },
      {
        "pattern": "\\[\\[[^\\]]*\\]\\]",
        "flags": "g"
      },
      {
        "pattern": "\\[[^\\]]*\\]\\([^)]*\\)",
        "flags": "g"
      }
    ],
    "pattern": "(?<![\\p{L}\\p{N}])@([\\p{L}][\\p{L}\\p{N}_:-]*)",
    "flags": "gu"
  }
}
