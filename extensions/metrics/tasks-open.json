{
  "id": "tasks-open",
  "storeName": "Incomplete tasks",
  "description": "Counts only incomplete task checkboxes (- [ ]).",
  "author": "pan4ratte",
  "updated": "2026-06-20",
  "type": "metric",
  "toggleLabel": "Tasks open",
  "hint": "Counts unchecked task checkboxes",
  "statusBarLabel": "Open",
  "defaultEnabled": false,
  "i18n": {
    "ru": {
      "storeName": "Открытые задачи",
      "description": "Считает только чекбоксы невыполненных задач (- [ ]).",
      "toggleLabel": "Открытые задачи",
      "hint": "Считает неотмеченные чекбоксы задач",
      "statusBarLabel": "Открыто задач"
    }
  },
  "count": {
    "mode": "matches",
    "source": "raw",
    "pattern": "^[ \\t]*[-*+] \\[ \\]",
    "flags": "gm"
  }
}
