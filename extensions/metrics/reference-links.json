{
  "id": "reference-links",
  "storeName": "Reference links",
  "description": "Counts reference-style links of the [id]: type.",
  "author": "pan4ratte",
  "updated": "2026-06-20",
  "type": "metric",
  "toggleLabel": "Reference links",
  "hint": "Counts reference-style links that have a matching [id]: definition",
  "statusBarLabel": "Ref links",
  "defaultEnabled": false,
  "i18n": {
    "ru": {
      "storeName": "Ссылки со сносками",
      "description": "Считает ссылки со сносками типа [id]:",
      "toggleLabel": "Ссылочные ссылки",
      "hint": "Считает ссылки ссылочного стиля с определением [id]:",
      "statusBarLabel": "Ссылок"
    }
  },
  "count": {
    "mode": "intersect",
    "source": "raw",
    "primary": {
      "pattern": "(?<!!)\\[[^\\]]*\\]\\[([^\\]]+)\\]",
      "flags": "g"
    },
    "secondary": {
      "pattern": "^[ \\t]*\\[(?!\\^)([^\\]]+)\\]:",
      "flags": "gm"
    }
  }
}
