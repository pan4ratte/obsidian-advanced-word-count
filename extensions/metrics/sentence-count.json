{
  "id": "sentence-count",
  "storeName": "Sentences",
  "description": "Counts the number of sentences in a note.",
  "author": "pan4ratte",
  "updated": "2026-06-20",
  "type": "metric",
  "toggleLabel": "Sentences",
  "hint": "Counts sentence-ending punctuation runs (. ! ?)",
  "statusBarLabel": "Sentences",
  "defaultEnabled": false,
  "i18n": {
    "ru": {
      "storeName": "Предложения",
      "description": "Считает количество предложений в заметке.",
      "toggleLabel": "Предложения",
      "hint": "Считает группы завершающей пунктуации (. ! ?)",
      "statusBarLabel": "Предложений"
    }
  },
  "count": {
    "pattern": "[.!?]+(?=\\s|$)",
    "flags": "g",
    "mode": "matches",
    "source": "preprocessed"
  }
}
