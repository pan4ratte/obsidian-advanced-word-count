{
  "id": "tasks-done",
  "storeName": "Completed tasks",
  "description": "Counts only completed task checkboxes (- [x] or - [X]).",
  "author": "pan4ratte",
  "updated": "2026-06-20",
  "type": "metric",
  "toggleLabel": "Tasks done",
  "hint": "Counts checked task checkboxes",
  "statusBarLabel": "Done",
  "defaultEnabled": false,
  "i18n": {
    "ru": {
      "storeName": "Выполненные задачи",
      "description": "Считает только чекбоксы выполненных задач (- [x] или - [X]).",
      "toggleLabel": "Выполненные задачи",
      "hint": "Считает отмеченные чекбоксы задач",
      "statusBarLabel": "Выполнено"
    }
  },
  "count": {
    "mode": "matches",
    "source": "raw",
    "pattern": "^[ \\t]*[-*+] \\[[xX]\\]",
    "flags": "gm"
  }
}
