{
  "id": "tags",
  "storeName": "Tags",
  "description": "Counts the number of #tags in a note.",
  "author": "pan4ratte",
  "updated": "2026-06-20",
  "type": "metric",
  "toggleLabel": "Tags",
  "hint": "Counts #tags (numeric-only tags ignored)",
  "statusBarLabel": "Tags",
  "defaultEnabled": false,
  "i18n": {
    "ru": {
      "storeName": "Теги",
      "description": "Считает количество #тегов в заметке.",
      "toggleLabel": "Теги",
      "hint": "Считает #теги (числовые теги игнорируются)",
      "statusBarLabel": "Тегов"
    }
  },
  "count": {
    "mode": "matches",
    "source": "raw",
    "pattern": "(?<![\\p{L}\\p{N}_#])#[\\p{L}\\p{N}_/-]+",
    "flags": "gu",
    "exclude": "^#[\\p{N}]+$",
    "excludeFlags": "u"
  }
}
