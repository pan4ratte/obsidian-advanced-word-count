{
  "id": "tags",
  "name": "Tag count",
  "description": "Counts Obsidian #tags, ignoring purely numeric tags (e.g. #123) and mid-word hashes.",
  "author": "pan4ratte",
  "updated": "2026-06-20",
  "type": "metric",
  "label": "Tags",
  "title": "Tags",
  "hint": "Counts #tags (numeric-only tags ignored)",
  "statusLabel": "Tags",
  "defaultEnabled": false,
  "count": {
    "mode": "matches",
    "source": "raw",
    "pattern": "(?<![\\p{L}\\p{N}_#])#[\\p{L}\\p{N}_/-]+",
    "flags": "gu",
    "exclude": "^#[\\p{N}]+$",
    "excludeFlags": "u"
  }
}
